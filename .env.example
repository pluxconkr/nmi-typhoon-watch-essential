# Server-only (used by src/app/api/summarize+api.ts — never shipped to the phone).
# Without it the app still works: alerts show the official NWS headline instead of the one-line summary.
ANTHROPIC_API_KEY=

# Which Claude model writes the one-sentence summary. Leave empty for the default (claude-opus-5).
# Cheaper options: claude-sonnet-5, claude-haiku-4-5. One call per alert, ~2k input + ~40 output tokens,
# so even a whole typhoon (≈40 NWS products) costs well under $1 on any of them.
SUMMARY_MODEL=

# Optional client settings (EXPO_PUBLIC_* values are inlined into the app bundle — never put secrets here).
# Absolute origin of the deployed API route for production builds (development uses the Metro dev server automatically).
# EXPO_PUBLIC_SUMMARY_URL=https://your-deployment.expo.app/api/summarize
# Optional HSEM shelter feed. When unset the bundled assets/data/shelters.json is the source of truth.
# EXPO_PUBLIC_SHELTERS_URL=https://example.org/cnmi-shelters.json
