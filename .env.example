# Server-only (used by src/app/api/summarize+api.ts — never shipped to the phone).
# Without it the app still works: alerts show the official NWS headline instead of the one-line summary.
# Get a key at https://openrouter.ai/keys — one key, any model, prepaid credits.
OPENROUTER_API_KEY=

# Which model writes the one-sentence summary (OpenRouter slug). Leave empty for the default.
# Examples: anthropic/claude-sonnet-5 (default), anthropic/claude-opus-5, openai/gpt-5.6-terra,
# google/gemini-3.8-flash, meta-llama/llama-4-maverick. Live list: https://openrouter.ai/models
# One call per alert, ~2k input + ~40 output tokens, so a whole typhoon (≈40 NWS products) costs cents.
SUMMARY_MODEL=

# Comma-separated models tried in order if the primary fails (OpenRouter automatic fallback).
# Leave empty for the default: google/gemini-3.8-flash,openai/gpt-5.6-terra
SUMMARY_FALLBACK_MODELS=

# Optional client settings (EXPO_PUBLIC_* values are inlined into the app bundle — never put secrets here).
# Absolute origin of the deployed API route for production builds (development uses the Metro dev server automatically).
# EXPO_PUBLIC_SUMMARY_URL=https://your-deployment.expo.app/api/summarize
# Optional HSEM shelter feed. When unset the bundled assets/data/shelters.json is the source of truth.
# EXPO_PUBLIC_SHELTERS_URL=https://example.org/cnmi-shelters.json
