{
  "expo": {
    "name": "NMI Typhoon Watch",
    "slug": "nmi-typhoon-watch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nmityphoonwatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.27363.nmityphoonwatch",
      "infoPlist": {
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2545",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tstst.nmityphoonwatch"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2545",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NMI Typhoon Watch uses your location only to sort shelters by distance. It works without a signal and is never uploaded.",
          "locationAlwaysAndWhenInUsePermission": "NMI Typhoon Watch uses your location only to sort shelters by distance. It works without a signal and is never uploaded."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B2545",
          "defaultChannel": "typhoon-alerts"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
